# Copia este archivo a .env (esta en .gitignore: nunca subas credenciales reales al repositorio).

# Gateway (Traefik)
# Dominio publico de la API. En local deja "localhost".
API_DOMAIN=localhost
# Correo para Let's Encrypt (solo compose.prod.yaml).
ACME_EMAIL=tu-correo@dominio.com
# Origenes del frontend permitidos por CORS, separados por coma.
CORS_ORIGIN=http://localhost:4200,https://frontend-pi-olive-30.vercel.app

# Base de datos (Supabase/Postgres via Connection Pooler). Ambos servicios comparten la base,
# pero cada uno solo mapea sus propias tablas (ver docs/microservicios.md).
DB_URL=jdbc:postgresql://aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.tu-proyecto-id
DB_PASSWORD=tu-password-de-supabase

# Seguridad (JWT, solo identity-service). Minimo 32 bytes UTF-8 y secreto en produccion.
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria-de-32+
JWT_EXPIRATION_MINUTES=120
