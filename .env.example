PORT=8080
CORS_ORIGIN=http://localhost:4200,https://frontend-pi-olive-30.vercel.app

# Conexion a Supabase (Postgres) via el Connection Pooler.
# Copia este archivo a .env y reemplaza los valores por los de tu proyecto de Supabase.
# .env esta en .gitignore: nunca subas credenciales reales al repositorio.
DB_URL=jdbc:postgresql://aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.tu-proyecto-id
DB_PASSWORD=tu-password-de-supabase

# Seguridad (JWT). JWT_SECRET debe tener minimo 32 bytes UTF-8 y ser secreto en produccion.
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria-de-32+
JWT_EXPIRATION_MINUTES=120
